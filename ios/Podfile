platform :ios, '17.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end

  # Force MinimumOSVersion to 17.0 on all vendored xcframeworks to satisfy App Store Connect validation
  Dir.glob("Pods/**/*.framework/Info.plist").each do |plist_path|
    system("plutil", "-replace", "MinimumOSVersion", "-string", "17.0", plist_path)
  end

  fuse_path = "./Pods/HyperSDK/Fuse.rb"
  clean_assets = true
  if File.exist?(fuse_path)
    if system("ruby", fuse_path.to_s, clean_assets.to_s)
    end
  end

  # Generate missing dSYMs for vendored xcframeworks (e.g. Airborne, HyperSDK) to satisfy App Store Connect symbol upload
  Dir.glob("Pods/**/*.xcframework/ios-arm64*/*.framework").each do |fw_path|
    fw_name = File.basename(fw_path, ".framework")
    binary_path = File.join(fw_path, fw_name)
    next unless File.file?(binary_path) && File.executable?(binary_path)

    slice_dir = File.dirname(fw_path)
    dsyms_dir = File.join(slice_dir, "dSYMs")
    dsym_file = File.join(dsyms_dir, "#{fw_name}.framework.dSYM")

    unless File.exist?(dsym_file)
      system("mkdir", "-p", dsyms_dir)
      system("dsymutil", binary_path, "-o", dsym_file)
    end
  end
end
